# Copie para .env.local ou .env (não commitar segredos)

# Postgres
# Em produção (Cloud Run ou qualquer servidor): defina DATABASE_URL e DIRECT_URL nas variáveis/segredos do serviço.
# Aplique as migrations com `npm run db:migrate` (ou `prisma migrate deploy`) no processo de release.
# Com pooler (Neon/Supabase), use URL direta em DIRECT_URL.
# Serverless ou pooler (PgBouncer/Neon/Supabase pooled): acrescente à DATABASE_URL (NÃO à DIRECT_URL)
#   ?pgbouncer=true&connection_limit=10&pool_timeout=20
# (pgbouncer=true desliga prepared statements; connection_limit evita esgotar conexões por instância).
DATABASE_URL="postgresql://bucomax:bucomax@localhost:5432/bucomax?schema=public"
DIRECT_URL="postgresql://bucomax:bucomax@localhost:5432/bucomax?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-com-openssl-rand-base64-32"

# Portal do paciente (cookie assinado; opcional — se vazio, reutiliza NEXTAUTH_SECRET)
# PATIENT_PORTAL_SECRET=

# Base URL do app (fetch do browser para /api). Em produção: URL pública do serviço (ex.: https://submanager-714014611104.us-east4.run.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis — filas BullMQ e SSE; Upstash em produção (URL rediss://).
# Deixe VAZIO se não for rodar Redis local: evita ECONNREFUSED e modo inline (sem worker BullMQ).
# Com URL preenchida: `docker compose up -d redis` (porta 6379) ou seu próprio servidor.
REDIS_URL=

# Só desenvolvimento: desliga rate limit `api` (120/min user) para scripts tipo audit:api-latency com alta concorrência.
# Nunca use em produção. Exige NODE_ENV !== production e reinício do Next.
# LOAD_TEST_DISABLE_API_RL=1

# Cliente: AES para estado persistido no localStorage (mín. 32 caracteres; público no bundle)
NEXT_PUBLIC_APP_PERSIST_SECRET="troque-com-string-longa-32-chars-minimo!!"

# Opcional: não sobe o worker BullMQ (notification/whatsapp/email) neste processo. Use quando o consumo
# das filas roda em outro serviço (ex.: worker dedicado no Cloud Run) — combine com QUEUE_EXTERNAL_WORKER=1
# lá embaixo. No Cloud Run com worker embutido, o serviço precisa de
# --no-cpu-throttling (ver cloudbuild.yaml).
# DISABLE_NOTIFICATION_WORKER=true

# URL pública nos links dos e-mails (Resend) — mesmo host em dev
APP_PUBLIC_URL="http://localhost:3000"

# Resend — https://resend.com
# Sem domínio verificado: use a API key "Onboarding" e EMAIL_FROM com onboarding@resend.dev (não use @resend.com).
# Com domínio verificado no painel: SubManager <noreply@seudominio.com>
RESEND_API_KEY=
EMAIL_FROM="SubManager <onboarding@resend.dev>"
# Webhook Resend (signing secret Svix) — `POST /api/v1/webhooks/resend`
RESEND_WEBHOOK_SECRET=

# Google Cloud Storage — upload direto do browser via URL pré-assinada (v4)
#
# GCS_PROJECT_ID declara o projeto GCP dono do bucket. O app recusa operar se a
# service account pertencer a outro projeto — guarda contra gravar arquivo clínico
# no lugar errado por credencial trocada. Não há nome fixo no código.
#
# Sugestão de buckets por ambiente (região única, ex.: southamerica-east1):
#   Dev:  <projeto>-dev-files   (lifecycle de 30d para não acumular lixo)
#   Prod: <projeto>-prod-files  (Nearline após 90d)
# Use uma service account dedicada, com objectAdmin apenas nesses buckets.
#
# Credenciais (uma das opções): (1) JSON inteiro da service account em uma linha em
# GCS_SERVICE_ACCOUNT_JSON; (2) caminho do arquivo em GOOGLE_APPLICATION_CREDENTIALS
# (dev local) + GCS_PROJECT_ID abaixo.
# Upload pelo browser exige CORS configurado no bucket.
GCS_BUCKET_NAME=
# Obrigatório. Deve bater com o project_id da service account.
GCS_PROJECT_ID=
# Colar o JSON da service account (mín.: project_id, client_email, private_key) — alternativa ao ADC.
# IMPORTANTE: valor em UMA linha e entre aspas simples, com as quebras da private_key escapadas como \n.
# JSON multi-linha quebra o parser do `docker compose` (o Next tolera, o compose não). Para converter:
#   node -e "console.log(JSON.stringify(require('fs').readFileSync('sa.json','utf8')))"
GCS_SERVICE_ACCOUNT_JSON=
# Opcional: URL pública estável (CDN ou bucket público); senão só download via presign
GCS_PUBLIC_BASE_URL=
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
# ADC (Cloud Run com a service account do serviço, sem chave): defina GOOGLE_CLOUD_PROJECT (ou GCLOUD_PROJECT)
# com o mesmo id de GCS_PROJECT_ID. A SA precisa de objectAdmin no bucket e serviceAccountTokenCreator nela mesma.
# GOOGLE_CLOUD_PROJECT=

# ─── Redis / BullMQ (opcional — sem essa variável roda em modo inline) ───
# Dev local (docker-compose): redis://localhost:6379
# Sem Redis: deixe VAZIO ou não defina para usar modo inline (sem fila, sem SSE)
# Upstash / managed Redis: redis://:<password>@<host>:<port>
REDIS_URL=

# ─── WhatsApp Business Cloud API ───
#
# Modelo Tech Provider: UM app Meta da plataforma, vários WABAs de clínicas conectados.
# Por isso as duas variáveis abaixo são da plataforma, não do tenant — quem assina o
# payload do webhook é a Meta, com o App Secret do app. O que é por tenant (número,
# WABA e access token) fica no banco, em Configurações › WhatsApp.
#
# Callback URL única (Meta › App › Webhooks): {APP_PUBLIC_URL}/api/v1/webhooks/whatsapp
#
# Chave AES-256-GCM (64 hex chars / 32 bytes) para criptografar o access token do tenant.
# Gerar: openssl rand -hex 32
WHATSAPP_ENCRYPTION_KEY=
# Token de verificação do webhook (GET de subscribe). Você inventa a string e cola
# igual no painel da Meta, em Webhooks › Verify Token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret do app Meta — valida a assinatura `x-hub-signature-256` no POST do webhook.
# Meta › App › Configurações › Básico › Chave Secreta do App.
# VAZIO = webhook responde 503 e nenhum callback é processado (fail-closed proposital).
WHATSAPP_APP_SECRET=

# ─── Sentry (observabilidade) ───
#
# Projeto único: org `tercon`, project `submanager`. Não apontar para outro projeto —
# o vínculo entre erro e relato de bug do widget de feedback depende disso.
#
# O DSN é público por natureza (vai no bundle do browser). Sem ele o SDK fica
# desligado e nada é enviado — é o modo padrão de dev local.
NEXT_PUBLIC_SENTRY_DSN=
# Rótulo do ambiente nos eventos: production | preview | development.
# Vazio = usa NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Amostragem de tracing, 0 a 1. Vazio = 0.1 em produção e 0 fora dela.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Rótulo do ambiente só no servidor (fallback de NEXT_PUBLIC_SENTRY_ENVIRONMENT; depois NODE_ENV).
SENTRY_ENVIRONMENT=
# Versão do app gravada em cada relato do widget de feedback (ex.: SHA do commit). Vazio = sem versão.
NEXT_PUBLIC_APP_VERSION=
# Token de upload de source map (build). SEGREDO — não commitar.
# Gerar em: Sentry › Settings › tercon › Auth Tokens (escopo project:releases).
# Local: o wizard já gravou em `.env.sentry-build-plugin` (gitignored).
# Cloud Build/CI: definir como secret do build, senão o stack trace de produção chega minificado.
SENTRY_AUTH_TOKEN=

# ─── Cron / filas ───
# Segredo do cron `/api/cron/sla-check` (Authorization: Bearer <CRON_SECRET>). Os jobs do Cloud Scheduler
# (scripts/cloud-scheduler-setup.sh) enviam o header. Gerar: openssl rand -hex 32
CRON_SECRET=
# Com DISABLE_NOTIFICATION_WORKER=true o processo não roda worker BullMQ: com REDIS_URL, emitters usam execução
# inline e o SSE de notificações cai para polling. Defina 1 SOMENTE se houver worker BullMQ em outro host
# consumindo as filas (notification / email / whatsapp).
QUEUE_EXTERNAL_WORKER=

# ─── Tokens / uploads ───
# Segredo base dos tokens de iframe dos apps (chave por app derivada via HKDF). Sem ele, cai no NEXTAUTH_SECRET.
APP_TOKEN_SECRET=
# 1 = PUT assinado exige x-goog-content-length-range (teto MAX_UPLOAD_SIZE_BYTES). Antes de ligar, o CORS do
# bucket GCS precisa permitir o header `x-goog-content-length-range`, senão o preflight do upload falha.
UPLOAD_ENFORCE_CONTENT_LENGTH_RANGE=

# ─── Proxy / IP do cliente (rate limit) ───
# O X-Forwarded-For pode vir forjado pelo cliente; o proxy confiável só ANEXA o IP real no
# fim da lista. TRUSTED_PROXY_HOPS = quantos proxies confiáveis existem na frente do app, e o IP usado é o
# da posição `length - hops`. Cloud Run direto = 1 (default). Atrás de um HTTPS Load Balancer = 2.
TRUSTED_PROXY_HOPS=1

# ─── Apps do marketplace em iframe ───
# Origens permitidas no CSP `frame-src`, separadas por vírgula (ex.: https://app-a.run.app,https://app-b.com).
# É lida no BUILD (next.config.ts): em Docker/Cloud Build vai como --build-arg, não como env de runtime.
ALLOWED_IFRAME_ORIGINS=

# ─── Portal do paciente: envio de OTP por WhatsApp ───
# Webhook que recebe POST JSON {"phone","text"} para entregar o código OTP ao paciente (WhatsApp ou outro canal).
# Vazio = o OTP não é enviado por esse canal.
PATIENT_PORTAL_OTP_NOTIFY_URL=
