# Copie para .env.local ou .env (não commitar segredos)

# Postgres
# Em produção (ex.: Vercel): defina DATABASE_URL e DIRECT_URL no painel do projeto.
# No Vercel use o comando de build `npm run build:vercel` (roda `prisma migrate deploy` antes do Next).
# Com pooler (Neon/Supabase), use URL direta em DIRECT_URL.
DATABASE_URL="postgresql://bucomax:bucomax@localhost:5432/bucomax?schema=public"
DIRECT_URL="postgresql://bucomax:bucomax@localhost:5432/bucomax?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-com-openssl-rand-base64-32"

# Portal do paciente (cookie assinado; opcional — se vazio, reutiliza NEXTAUTH_SECRET)
# PATIENT_PORTAL_SECRET=

# Base URL do app (fetch do browser para /api). Em produção (ex.: Vercel): https://seu-projeto.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis — filas BullMQ e SSE; Upstash em produção (URL rediss://).
# Deixe VAZIO se não for rodar Redis local: evita ECONNREFUSED e modo inline (sem worker BullMQ).
# Com URL preenchida: `docker compose up -d redis` (porta 6379) ou seu próprio servidor.
REDIS_URL=

# Só desenvolvimento: desliga rate limit `api` (120/min user) para scripts tipo audit:api-latency com alta concorrência.
# Nunca use em produção. Exige NODE_ENV !== production e reinício do Next.
# BUCOMAX_LOAD_TEST_DISABLE_API_RL=1

# Cliente: AES para estado persistido no localStorage (mín. 32 caracteres; público no bundle)
NEXT_PUBLIC_APP_PERSIST_SECRET="troque-com-string-longa-32-chars-minimo!!"

# Opcional: forçar a não subir o worker BullMQ no mesmo processo (ex.: deploy não serverless com Redis)
# DISABLE_NOTIFICATION_WORKER=true

# URL pública nos links dos e-mails (Resend) — mesmo host em dev
APP_PUBLIC_URL="http://localhost:3000"

# Resend — https://resend.com
# Sem domínio verificado: use a API key "Onboarding" e EMAIL_FROM com onboarding@resend.dev (não use @resend.com).
# Com domínio verificado no painel: Bucomax <noreply@seudominio.com>
RESEND_API_KEY=
EMAIL_FROM="Bucomax <onboarding@resend.dev>"
# Webhook Resend (signing secret Svix) — `POST /api/v1/webhooks/resend`
RESEND_WEBHOOK_SECRET=

# Google Cloud Storage — upload direto do browser via URL pré-assinada (v4)
# O app só aceita o projeto GCP "bucomax" para Storage (código em src/lib/constants/gcs.ts).
# Buckets por ambiente:
#   Dev:  bucomax-dev-files  (southamerica-east1, lifecycle 30d auto-delete)
#   Prod: bucomax-prod-files (southamerica-east1, Nearline após 90d)
# SA dedicada: bucomax-storage@bucomax.iam.gserviceaccount.com (objectAdmin nos buckets)
# Credenciais (uma das opções): (1) JSON inteiro da service account em uma linha em GCS_SERVICE_ACCOUNT_JSON
# (2) caminho do arquivo JSON em GOOGLE_APPLICATION_CREDENTIALS (dev local) + GCS_PROJECT_ID abaixo
# Upload pelo browser exige CORS no bucket (já configurado via gcloud).
GCS_BUCKET_NAME=bucomax-dev-files
# Obrigatório se o JSON da SA não tiver project_id; deve ser bucomax (único projeto permitido para bucket)
GCS_PROJECT_ID=bucomax
# Colar o JSON da service account (mín.: project_id, client_email, private_key) — comum em Vercel/serverless.
# IMPORTANTE: valor em UMA linha e entre aspas simples, com as quebras da private_key escapadas como \n.
# JSON multi-linha quebra o parser do `docker compose` (o Next tolera, o compose não). Para converter:
#   node -e "console.log(JSON.stringify(require('fs').readFileSync('sa.json','utf8')))"
GCS_SERVICE_ACCOUNT_JSON=
# Opcional: URL pública estável (CDN ou bucket público); senão só download via presign
GCS_PUBLIC_BASE_URL=
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json

# ─── Redis / BullMQ (opcional — sem essa variável roda em modo inline) ───
# Dev local (docker-compose): redis://localhost:6379
# Vercel / serverless: deixe VAZIO ou não defina para usar modo inline (sem fila, sem SSE)
# Upstash / managed Redis: redis://:<password>@<host>:<port>
REDIS_URL=

# ─── WhatsApp Business Cloud API ───
#
# Modelo Tech Provider: UM app Meta da plataforma, vários WABAs de clínicas conectados.
# Por isso as duas variáveis abaixo são da plataforma, não do tenant — quem assina o
# payload do webhook é a Meta, com o App Secret do app. O que é por tenant (número,
# WABA e access token) fica no banco, em Configurações › WhatsApp.
#
# Callback URL única (Meta › App › Webhooks): {APP_PUBLIC_URL}/api/v1/webhooks/whatsapp
#
# Chave AES-256-GCM (64 hex chars / 32 bytes) para criptografar o access token do tenant.
# Gerar: openssl rand -hex 32
WHATSAPP_ENCRYPTION_KEY=
# Token de verificação do webhook (GET de subscribe). Você inventa a string e cola
# igual no painel da Meta, em Webhooks › Verify Token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret do app Meta — valida a assinatura `x-hub-signature-256` no POST do webhook.
# Meta › App › Configurações › Básico › Chave Secreta do App.
# VAZIO = webhook responde 503 e nenhum callback é processado (fail-closed proposital).
WHATSAPP_APP_SECRET=
